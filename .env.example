# 배포할 때 넣을 환경변수. 이 파일 자체는 비밀이 없으니 저장소에 올려 둔다.
# 실제 값은 배포 플랫폼의 설정 화면(또는 secrets)에 넣는다.

SPRING_PROFILES_ACTIVE=prod

# 데이터베이스 (배포 플랫폼이 만들어 주는 PostgreSQL)
DATABASE_URL=jdbc:postgresql://호스트:5432/데이터베이스이름
DATABASE_USER=사용자
DATABASE_PASSWORD=비밀번호

# 토큰 서명 키 — 32바이트 이상. 아래 명령으로 만든다.
#   openssl rand -base64 48
# 이 값이 새면 누구나 아무 계정으로 로그인하는 토큰을 만들 수 있다.
JWT_SECRET=

# 프런트를 같은 서버가 서빙하므로 보통은 비워 둬도 된다.
# 나중에 프런트를 따로 띄우면 그 주소를 넣는다. 쉼표로 여러 개.
CORS_ORIGINS=

# 선택
PORT=8080
DB_POOL_SIZE=10
