# deploy/docker-compose.prod.yml 이 읽는 값. 이 파일을 .env 로 복사해서 채운다.
# .env 는 절대 저장소에 올리지 않는다 (.gitignore 에 들어 있다).

# 접속할 도메인. 이 이름이 서버 IP 를 가리키고 있어야 인증서가 발급된다.
DOMAIN=dongsa.example.com

# 데이터베이스
POSTGRES_DB=dongsa
POSTGRES_USER=dongsa
POSTGRES_PASSWORD=

# 토큰 서명 키 — openssl rand -base64 48
JWT_SECRET=
